<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0 ONLY for v0.1. Do not add netstandard2.0 here without also adding
      a BouncyCastle (or similar) fallback for AesGcm/Ed25519 — see CLAUDE.md
      "Cryptography Backend" gotcha. Do not "fix" the NSec.Cryptography
      dependency below by swapping to BCL Ed25519 — BCL Ed25519 does not
      exist until .NET 9.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <!--
      Required by exactly one type: CanonicalJson.SerdeJsonEscaper in Proof.cs.
      System.Text.Encodings.Web.TextEncoder's extension points
      (TryEncodeUnicodeScalar / FindFirstCharacterToEncode) are declared with
      char* parameters, so a custom encoder cannot be written without this.
      That encoder is the only unsafe code in this assembly, its two unsafe
      methods bounds-check every write, and there is no other way to make the
      offline-proof canonical JSON byte-identical to serde_json — see the
      escaping notes on CanonicalJson. Do not use this flag as licence to add
      pointer code elsewhere.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Tamga.Sdk</RootNamespace>
    <AssemblyName>Tamga.Sdk</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package metadata">
    <PackageId>Tamga.Sdk</PackageId>
    <Authors>Tamga</Authors>
    <Description>Official .NET SDK for Tamga. Integrate license activation, offline verification, and machine management into your .NET applications.</Description>
    <RepositoryUrl>https://github.com/tamga-sh/tamga-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!--
      Canonical keyword set, identical across every Tamga SDK. Keep these five
      in this order and do not append per-language extras — the whole point is
      that a search hits the fleet uniformly.
    -->
    <PackageTags>licensing;software-licensing;license-key;activation;entitlements</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      MinVer (below) derives the package version from the git tag at pack
      time. There is deliberately no <Version> here to hand-bump — see
      CLAUDE.md "Versioning & Release".
    -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    The artifact-download HttpClient is created lazily and owned conditionally,
    and the only honest way to test that contract is to look at it directly:
    every alternative needed a real socket, and "no live-network HTTP calls in
    tests" is a rule in this repo (see CLAUDE.md "Testing"). An earlier attempt
    to reach it by cancelling the token passed while never executing the code —
    HttpClient observes the token in ReadAsStringAsync on the FIRST leg, so the
    download client was never created and the test asserted a true thing for a
    false reason. Adds no public API surface.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Tamga.Sdk.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Ed25519 has no BCL implementation on net8.0 (arrives in .NET 9's
      System.Security.Cryptography). NSec.Cryptography (libsodium binding) is
      the one non-BCL crypto dependency in this SDK — see CLAUDE.md.
    -->
    <PackageReference Include="NSec.Cryptography" Version="24.4.0" />
  </ItemGroup>

</Project>
