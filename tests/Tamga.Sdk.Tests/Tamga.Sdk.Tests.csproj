<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Tamga.Sdk.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tamga.Sdk/Tamga.Sdk.csproj" />
  </ItemGroup>

  <!--
    Server-issued .machine fixtures, embedded (not copied) so a CI run needs
    nothing on disk beside the test assembly. LogicalName is pinned rather
    than left to MSBuild's directory-to-namespace mangling, so a future
    fixture drop can be dropped in verbatim and picked up by name.
    See Fixtures/MachineFiles/PROVENANCE.md — do NOT regenerate these here.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/MachineFiles/*.machine;Fixtures/MachineFiles/manifest.json">
      <LogicalName>MachineFileFixtures/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    Signing-key id vectors, embedded on the same terms as the machine-file
    fixtures above: generated by an independent SHA-256 implementation, NOT by
    this SDK, so the tests run offline and cannot pass by agreeing with
    themselves. See Fixtures/SigningKeys/PROVENANCE.md — do NOT regenerate.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/SigningKeys/signing-key-ids.json">
      <LogicalName>SigningKeyFixtures/%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    Inline coverage-gate threshold for `dotnet test`. Matches the CI
    invocation in .github/workflows/ci.yml — see CLAUDE.md "Testing".
    Not embedded as a static <CoverletThreshold> here because CI passes it
    explicitly via /p: flags; kept here as the documented local-run default.
  -->
  <PropertyGroup Label="Coverage gate (CI passes these explicitly; see .github/workflows/ci.yml)">
    <Threshold>80</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
  </PropertyGroup>

</Project>
