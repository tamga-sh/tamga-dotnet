# Force LF line endings on checkout regardless of platform/core.autocrlf —
# without this, Windows runners (core.autocrlf=true by default) convert
# LF-committed files to CRLF on checkout, which then fails
# `dotnet format --verify-no-changes`'s ENDOFLINE rule (.editorconfig sets
# end_of_line = lf) even though the repository content itself is all LF.
* text=auto eol=lf

# Server-issued crypto fixtures — byte-exact, never line-ending-normalized.
# See tests/Tamga.Sdk.Tests/Fixtures/MachineFiles/PROVENANCE.md.
tests/Tamga.Sdk.Tests/Fixtures/MachineFiles/*.machine -text
